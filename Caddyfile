# uzdoom-wasm Caddy config — serve the built WASM artifacts with the
# Cross-Origin-Opener / Cross-Origin-Embedder headers that SharedArrayBuffer
# (and therefore pthreads) requires.
#
# Default: listen on :80 for plain HTTP. Put a reverse proxy in front for
# HTTPS, or change this block to `your-domain.com { ... }` and Caddy will
# provision a Let's Encrypt cert automatically.

:80 {
    root * /srv
    encode gzip zstd
    file_server {
        index index.html
    }

    # Required for crossOriginIsolated === true (enables SharedArrayBuffer,
    # which Emscripten pthreads builds depend on).
    header {
        Cross-Origin-Opener-Policy   "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        Cross-Origin-Resource-Policy "same-origin"

        # Standard security hardening
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "no-referrer"
    }

    # Asset URLs carry ?v=<hash of the engine files>, stamped by the
    # Dockerfile, so a versioned response never changes. Everything else,
    # index.html included, is revalidated on each load (a 304 when nothing
    # changed), so a deploy is picked up on the next visit.
    @versioned query v=*
    header @versioned Cache-Control "public, max-age=31536000, immutable"

    @unversioned {
        not query v=*
        not path /private/*
    }
    header @unversioned Cache-Control "no-cache"

    # Emscripten produces .wasm with the correct MIME type by default on
    # Caddy, but be explicit for older or customised setups.
    @wasm path *.wasm
    header @wasm Content-Type "application/wasm"

    # Side-loaded WADs and mods: files mounted at runtime via
    # `docker run -v ...` into /srv/private/. Kept out of the image and out
    # of search engines. The loader keeps its own copy in IndexedDB and
    # checks these with a HEAD request, so the HTTP cache must not pin an
    # old version.
    @sideloaded path /private/*
    header @sideloaded {
        X-Robots-Tag  "noindex, nofollow"
        Cache-Control "private, no-cache"
    }
}
